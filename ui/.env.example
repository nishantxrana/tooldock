# ToolDock - environment variables reference
#
# This file documents every variable the project reads.
# Copy to .env.local for local overrides (git-ignored).
#
# ── Vercel deployment ────────────────────────────────────────────────────────
#
# Set these in Vercel dashboard → Project → Settings → Environment Variables.
# They are NOT Vite build-time vars (no VITE_ prefix) - they run in the
# Vercel Edge Runtime (middleware.ts) and are never sent to the browser.

# Your live domain. Activates the proxy origin check in middleware.ts:
# requests to /ado/* and /vsrm/* whose Origin or Referer header does not
# start with this value are rejected with 403.
# Leave unset for local dev - the check is skipped automatically.
ALLOWED_ORIGIN=https://tooldock.notbatman.me

# ── Vite build-time variables (VITE_ prefix = safe to expose in the browser) ─
#
# These are baked into the JS bundle at build time. Set them in Vercel dashboard
# under Environment Variables, same as ALLOWED_ORIGIN.

# Footer portfolio / GitHub link. Defaults to https://github.com/nishantxrana/portfolio
# if not set.
VITE_PORTFOLIO_URL=https://github.com/nishantxrana/portfolio

# ── Auto-injected by Vercel (do not set manually) ────────────────────────────
#
# VERCEL_URL  - raw hostname of the deployment (e.g. tooldock-one.vercel.app).
#               middleware.ts uses this as a fallback alongside ALLOWED_ORIGIN
#               so both the custom domain and the .vercel.app URL work.
#               Vercel sets this automatically on every deployment.
