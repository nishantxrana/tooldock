{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/ado/:path*", "destination": "https://dev.azure.com/:path*" },
    { "source": "/vsrm/:path*", "destination": "https://vsrm.dev.azure.com/:path*" },
    { "source": "/((?!ado/|vsrm/).*)", "destination": "/index.html" }
  ]
}
